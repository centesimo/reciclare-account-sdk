{
    "name": "reciclareaccount/account-api-client",
    "description": "API for OAuth clients account authentication",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "authors": [
        {
            "name": "Reciclare Qualidade",
            "email": "reciclare@reciclarequalidade.com.br"
        }
    ],
    "autoload": {
        "psr-4": {
            "ReciclareAccount\\AccountClientSDK\\": "src"
        }
    },
    "require": {
        "php": ">=8.2",
        "guzzlehttp/guzzle": "^7.2",
        "nesbot/carbon": "^3.9.1",
        "aura/session": "^4.0"
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "ReciclareAccount\\AccountClientSDK\\AccountApiServiceProvider"
            ]
        }
    }
}